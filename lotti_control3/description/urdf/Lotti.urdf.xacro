<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Lotti3">

<!-- included files for properties -->
    <xacro:include filename="urdf_inertial_shapes.xacro" />
    <xacro:include filename="urdf_materials.xacro"/>

<!-- include files for parts -->    
    <xacro:include filename="Lotti_arm3.xacro"/>
    <xacro:include filename="Lotti_body.xacro"/>
    <!-- <xacro:include filename="Lotti_lidar.xacro"/> -->

<!-- include controllers -->
<!-- <xacro:include filename="Lotti_gazebo_control.xacro"/> -->
    <xacro:include filename="$(find lotti_control3)/ros2_control/Lotti.ros2_control.xacro"/>


<!-- world origin -->
<!--     <link name="world"></link> -->

</robot>