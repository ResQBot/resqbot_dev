<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lotti_control3</name>
  <version>0.3.0</version>
  <description>
    Hardware interfaces, URDF description, controllers, and launch files for the Lotti3 rescue robot.
  </description>
  <maintainer email="office@campus-robo.at">Res.Q Bots</maintainer>
  <license>BSD</license>
  <author email="office@campus-robo.at">Res.Q Bots</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>hardware_interface</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>rcpputils</build_depend>

  <!-- Runtime dependencies -->
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rcpputils</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>lotti_teleop</exec_depend>
  <exec_depend>lotti_drive_controller</exec_depend>
  <exec_depend>lotti_flipper3_controller</exec_depend>

  <!-- Gazebo simulation dependencies (runtime only — loaded as plugins) -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
