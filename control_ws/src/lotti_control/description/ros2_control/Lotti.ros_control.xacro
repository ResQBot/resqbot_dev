<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <ros2_control name="LottiArm" type="system">
        <hardware>
            <plugin>arm_interface/ArmInterface</plugin>    
            <!-- <param name="arm_enc_res">4096</param> -->
            <!-- <param name="arm_max_torque">${9.81*30/100}</param> -->
            <!-- <param name="arm_max_volt">12</param>           -->
        </hardware>

        <joint name="arm_link1_joint">
            <command_interface name="position">
                <!-- <param name="min">${-pi/2}</param> -->
                <!-- <param name="max">${pi/2}</param> -->
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="volt"/>
        </joint>

        <joint name="arm_link2_joint">
            <command_interface name="position">
                <!-- <param name="min">${-pi/2}</param> -->
                <!-- <param name="max">${pi/2}</param> -->
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="volt"/>
        </joint>

        <joint name="arm_link3_joint">
            <command_interface name="position">
                <!-- <param name="min">${-pi/2}</param> -->
                <!-- <param name="max">${pi/2}</param> -->
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="volt"/>
        </joint>

        <joint name="arm_link4_joint">
            <command_interface name="position">
                <!-- <param name="min">${-pi/2}</param> -->
                <!-- <param name="max">${pi/2}</param> -->
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="volt"/>
        </joint>

        <joint name="arm_link5_joint">
            <command_interface name="position">
                <!-- <param name="min">${-pi/3}</param> -->
                <!-- <param name="max">${pi/3}</param> -->
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="volt"/>
        </joint>

        <joint name="arm_link6_joint">
            <command_interface name="position">
                <!-- <param name="min">${-pi}</param> -->
                <!-- <param name="max">${pi}</param> -->
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="volt"/>
        </joint>
    </ros2_control>

    <ros2_control name="LottiFlipper" type="system">
        <hardware>
            <plugin>flipper_interface/FlipperInterface</plugin>
        </hardware>
        
        <joint name="flipper_fr_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="flipper_fl_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="flipper_rr_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="flipper_rl_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>

     <ros2_control name="LottiChains" type="system">
        <hardware>
            <plugin>diffdrive_lotti/DiffDriveLotti</plugin>
            <param name="left_wheel_name">left_chain_joint</param>
            <param name="right_wheel_name">right_chain_joint</param>
            <param name="loop_rate">30</param>
            <param name="device">/dev/serial/by-path/platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.3:1.0-port0</param>
            <param name="baud_rate">57600</param>
            <param name="timeout_ms">1000</param>
            <param name="enc_counts_per_rev">3436</param>
            <param name="pid_p">20</param>
            <param name="pid_d">12</param>
            <param name="pid_i">0</param>
            <param name="pid_o">50</param>
        </hardware>
        <joint name="left_chain_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="right_chain_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

