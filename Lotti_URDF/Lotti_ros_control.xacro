<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!-- left chain -->
    <ros2_control name="left_chain_control" type="actuator">
        <hardware>
            <plugin>gazebo_ros2_control/LottiControlls</plugin>
        </hardware>

        <joint name="left_chain_joint">
            <command_interface name="velocity">
                <param name="min">-15</param>
                <param name="max">15</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>

        </joint>
    </ros2_control>


<!-- right chain -->
    <ros2_control name="right_chain_control" type="actuator">
        <hardware>
            <plugin>ros2_control_demo_hardware/PositionActuatorHardware</plugin>
            <param name="example_param_write_for_sec">1.23</param>
            <param name="example_param_read_for_sec">3</param>
        </hardware>
        <joint name="joint1">
            <command_interface name="position">
                <param name="min">-1</param>
                <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
    </ros2_control>


<!-- front right flipper -->
    <ros2_control name="flipper_fr_control" type="actuator">
        <hardware>

        </hardware>
        <joint name="flipper_fr_joint">
            <command_interface name="velocity">
                <param name="min">-1</param>
                <param name="max">1</param>
                <param name="initial_value">0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
    </ros2_control>
    
    
</robot>    