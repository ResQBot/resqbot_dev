<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <ros2_control name="LottiControlls" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/LottiControlls</plugin>
        </hardware>
        <joint name="left_chain_joint">
            <command_interface name="velocity">
                <param name="min">-15</param>
                <param name="max">15</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>

</robot>    